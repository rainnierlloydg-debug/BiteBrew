NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=mysql://ellas_node:CHANGE_ME@127.0.0.1:3306/ellas_pizza_node
SESSION_SECRET=GENERATE_AT_LEAST_48_RANDOM_BYTES
SESSION_MINUTES=120
TRUST_PROXY=0
UPLOAD_DIR=./var/uploads
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Local test database only. Never point tests at business records.
TEST_DATABASE_URL=mysql://ellas_node_test:CHANGE_ME@127.0.0.1:3306/ellas_pizza_node_test
# Optional read-only legacy import, never exposed to the browser.
LEGACY_ENV_PATH=./var/import/source.env
LEGACY_MEDIA_ROOT=./var/import
