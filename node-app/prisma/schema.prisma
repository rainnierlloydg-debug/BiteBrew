generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
  KITCHEN
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum OrderType {
  DINE_IN
  TAKEAWAY
  PICKUP
}
enum PaymentMethod {
  CASH
  GCASH
}
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  name               String    @db.VarChar(120)
  email              String    @unique @db.VarChar(190)
  passwordHash       String    @db.VarChar(255)
  role               Role
  active             Boolean   @default(true)
  registrationPending Boolean  @default(false)
  authVersion        Int       @default(1)
  archivedAt         DateTime? @db.DateTime(3)
  archivedById       String?   @db.Char(36)
  createdAt          DateTime  @default(now()) @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @db.DateTime(3)
  orders             Order[]
  payments           Payment[] @relation("PaymentRecorder")
  verifications      Payment[] @relation("PaymentVerifier")
  refunds            Refund[]
  history            OrderHistory[]
  requests           ActionRequest[] @relation("Requester")
  decisions          ActionRequest[] @relation("Reviewer")
  sessions           Session[]
  operations         Idempotency[]
  audits             AuditLog[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  chatMessages       ChatMessage[]
  supportMessages    SupportMessage[]
  chatParticipants   ChatParticipant[]
  @@index([role, active, archivedAt])
  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(128)
  data      Json
  userId    String?  @db.Char(36)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.DateTime(3)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id           String    @id @default(uuid()) @db.Char(36)
  name         String    @unique @db.VarChar(100)
  active       Boolean   @default(true)
  archivedAt   DateTime? @db.DateTime(3)
  archivedById String?   @db.Char(36)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  products     MenuItem[]
  @@map("categories")
}

model MenuItem {
  id           String    @id @default(uuid()) @db.Char(36)
  code         String    @unique @db.VarChar(40)
  name         String    @db.VarChar(120)
  categoryId   String    @db.Char(36)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description  String?   @db.Text
  image        String?   @db.VarChar(255)
  imageFrame   Json?
  demo         Boolean   @default(false)
  active       Boolean   @default(true)
  sortOrder    Int       @default(100)
  archivedAt   DateTime? @db.DateTime(3)
  archivedById String?   @db.Char(36)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  variants     Variant[]
  @@index([categoryId, archivedAt, active])
  @@map("menu_items")
}

model Variant {
  id          String   @id @default(uuid()) @db.Char(36)
  menuItemId  String   @db.Char(36)
  product     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name        String   @db.VarChar(80)
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  addons      AddonVariant[]
  orderItems  OrderItem[]
  @@unique([menuItemId, name])
  @@map("variants")
}

model Addon {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  variants  AddonVariant[]
  @@map("addons")
}

model AddonVariant {
  addonId   String  @db.Char(36)
  variantId String  @db.Char(36)
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Restrict)
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@id([addonId, variantId])
  @@index([variantId])
  @@map("addon_variants")
}

model Discount {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @db.VarChar(100)
  kind      String    @db.VarChar(12)
  value     Decimal   @db.Decimal(12, 2)
  active    Boolean   @default(true)
  startsAt  DateTime?  @db.DateTime(3)
  endsAt    DateTime?  @db.DateTime(3)
  createdAt DateTime   @default(now()) @db.DateTime(3)
  updatedAt DateTime   @updatedAt @db.DateTime(3)
  @@map("discounts")
}

model Customer {
  id           String    @id @default(uuid()) @db.Char(36)
  name         String    @db.VarChar(120)
  contact      String?   @db.VarChar(40)
  active       Boolean   @default(true)
  archivedAt   DateTime? @db.DateTime(3)
  archivedById String?   @db.Char(36)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  orders       Order[]
  account      CustomerAccount?
  @@index([name])
  @@index([contact])
  @@map("customers")
}

model CustomerAccount {
  id           String   @id @default(uuid()) @db.Char(36)
  customerId   String   @unique @db.Char(36)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  checkouts    CustomerCheckout[]
  supportConversation SupportConversation?
  @@map("customer_accounts")
}

model CustomerCheckout {
  id        String @id @default(uuid()) @db.Char(36)
  accountId String @db.Char(36)
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  key       String @db.Char(36)
  hash      String @db.Char(64)
  orderId   String @unique @db.Char(36)
  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  result    Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([accountId, key])
  @@map("customer_checkouts")
}

model Order {
  id                 String      @id @default(uuid()) @db.Char(36)
  number             String      @unique @db.VarChar(40)
  type               OrderType
  customerId         String?     @db.Char(36)
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName       String?     @db.VarChar(120)
  contact            String?     @db.VarChar(40)
  tableNumber        String?     @db.VarChar(20)
  pickupAt           DateTime?   @db.DateTime(3)
  instructions       String?     @db.Text
  status             OrderStatus @default(PENDING)
  version            Int         @default(1)
  subtotal           Decimal     @db.Decimal(12, 2)
  discount           Decimal     @db.Decimal(12, 2)
  charges            Decimal     @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  paid               Decimal     @default(0) @db.Decimal(12, 2)
  refunded           Decimal     @default(0) @db.Decimal(12, 2)
  pricingSnapshot    Json
  businessSnapshot   Json
  createdById        String?     @db.Char(36)
  createdBy          User?       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdByName      String      @db.VarChar(120)
  confirmedAt        DateTime?   @db.DateTime(3)
  preparingAt        DateTime?   @db.DateTime(3)
  completedAt        DateTime?   @db.DateTime(3)
  cancelledAt        DateTime?   @db.DateTime(3)
  createdAt          DateTime    @default(now()) @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @db.DateTime(3)
  items              OrderItem[]
  history            OrderHistory[]
  payments           Payment[]
  refunds            Refund[]
  requests           ActionRequest[]
  chatRoom           ChatRoom?
  customerCheckout   CustomerCheckout?
  @@index([status, createdAt])
  @@index([completedAt, createdById])
  @@index([customerId, createdAt])
  @@index([pickupAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Char(36)
  orderId      String   @db.Char(36)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId    String   @db.Char(36)
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  name         String   @db.VarChar(120)
  variantName  String   @db.VarChar(80)
  quantity     Int
  basePrice    Decimal  @db.Decimal(12, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  addons       Json
  instructions String?  @db.VarChar(500)
  removedAt    DateTime? @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderHistory {
  id        String      @id @default(uuid()) @db.Char(36)
  orderId   String      @db.Char(36)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String      @db.Char(36)
  actor     User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  from      OrderStatus?
  to        OrderStatus
  reason    String?     @db.VarChar(1000)
  createdAt DateTime    @default(now()) @db.DateTime(3)
  @@index([orderId, createdAt])
  @@map("order_history")
}

model Payment {
  id             String        @id @default(uuid()) @db.Char(36)
  orderId        String        @db.Char(36)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedById   String        @db.Char(36)
  recordedBy     User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verifiedById   String?       @db.Char(36)
  verifiedBy     User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  method         PaymentMethod
  status         PaymentStatus
  amount         Decimal       @db.Decimal(12, 2)
  tendered       Decimal?      @db.Decimal(12, 2)
  change         Decimal       @default(0) @db.Decimal(12, 2)
  reference      String?       @db.VarChar(100)
  referenceKey   String?       @unique @db.Char(64)
  verifiedAt     DateTime?     @db.DateTime(3)
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @db.DateTime(3)
  refunds        Refund[]
  requests       ActionRequest[]
  @@index([orderId, status])
  @@index([verifiedAt, recordedById])
  @@map("payments")
}

model Refund {
  id             String        @id @default(uuid()) @db.Char(36)
  paymentId      String        @db.Char(36)
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId        String        @db.Char(36)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId        String        @db.Char(36)
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reason         String        @db.VarChar(1000)
  recognizedSale Boolean
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  @@index([orderId])
  @@index([paymentId])
  @@index([createdAt, recognizedSale])
  @@map("refunds")
}

model ActionRequest {
  id           String        @id @default(uuid()) @db.Char(36)
  kind         String        @db.VarChar(12)
  orderId      String        @db.Char(36)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId    String?       @db.Char(36)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedById String       @db.Char(36)
  requestedBy  User          @relation("Requester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById String?       @db.Char(36)
  reviewedBy   User?         @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  status       RequestStatus @default(PENDING)
  amount       Decimal?      @db.Decimal(12, 2)
  reason       String        @db.VarChar(1000)
  decisionNote String?       @db.VarChar(1000)
  reviewedAt   DateTime?     @db.DateTime(3)
  createdAt    DateTime      @default(now()) @db.DateTime(3)
  @@index([status, kind])
  @@index([orderId])
  @@map("action_requests")
}

model Idempotency {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  operation String   @db.VarChar(120)
  key       String   @db.Char(36)
  hash      String   @db.Char(64)
  result    Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([userId, operation, key])
  @@map("idempotency_records")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String   @db.Char(36)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(80)
  recordType String   @db.VarChar(40)
  recordId   String?  @db.VarChar(64)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)
  @@index([recordType, recordId])
  @@index([createdAt, actorId])
  @@map("audit_logs")
}

model Setting {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@map("business_settings")
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventKey  String    @db.VarChar(120)
  kind      String    @db.VarChar(30)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(255)
  url       String    @db.VarChar(255)
  readAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  deliveries PushDelivery[]
  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @db.Char(36)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpointKey String   @unique @db.Char(64)
  subscription Json
  preferences Json
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  deliveries  PushDelivery[]
  @@index([userId])
  @@map("push_subscriptions")
}

model PushDelivery {
  id             String           @id @default(uuid()) @db.Char(36)
  notificationId String           @db.Char(36)
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String           @db.Char(36)
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         String           @default("PENDING") @db.VarChar(12)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now()) @db.DateTime(3)
  sentAt         DateTime?        @db.DateTime(3)
  @@unique([notificationId, subscriptionId])
  @@index([status, nextAttemptAt])
  @@map("push_deliveries")
}

model SupportConversation {
  id        String @id @default(uuid()) @db.Char(36)
  accountId String @unique @db.Char(36)
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  messages  SupportMessage[]
  @@map("support_conversations")
}

model SupportMessage {
  id             Int @id @default(autoincrement())
  conversationId String @db.Char(36)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  staffId        String? @db.Char(36)
  staff          User? @relation(fields: [staffId], references: [id], onDelete: Restrict)
  senderKey      String @db.VarChar(45)
  senderName     String @db.VarChar(120)
  senderRole     String @db.VarChar(20)
  clientId       String @db.Char(36)
  text           String @db.VarChar(2000)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  @@unique([conversationId, senderKey, clientId])
  @@index([conversationId, id])
  @@map("support_messages")
}

model ChatRoom {
  id           String            @id @default(uuid()) @db.Char(36)
  key          String            @unique @db.VarChar(80)
  name         String            @db.VarChar(120)
  orderId      String?           @unique @db.Char(36)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now()) @db.DateTime(3)
  participants ChatParticipant[]
  messages     ChatMessage[]
  @@map("chat_rooms")
}

model ChatParticipant {
  roomId            String   @db.Char(36)
  room              ChatRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  userId            String   @db.Char(36)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadMessageId Int      @default(0)
  joinedAt          DateTime @default(now()) @db.DateTime(3)
  @@id([roomId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  roomId        String   @db.Char(36)
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  senderId      String   @db.Char(36)
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderName    String   @db.VarChar(120)
  senderRole    Role
  clientId      String   @db.Char(36)
  text          String   @db.VarChar(2000)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  @@unique([senderId, clientId])
  @@index([roomId, id])
  @@map("chat_messages")
}

model ImportLedger {
  key        String   @id @db.VarChar(120)
  targetId   String   @db.Char(36)
  importedAt DateTime @default(now()) @db.DateTime(3)
  @@map("import_ledger")
}
