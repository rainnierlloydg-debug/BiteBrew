NODE_ENV=production
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
# Keep application tables in a schema that is not exposed by the Supabase Data API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&sslmode=require&schema=bitebrew
# Session pooler (IPv4); also used for migrations and Socket.IO LISTEN/NOTIFY.
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&schema=bitebrew
SESSION_SECRET=GENERATE_AT_LEAST_48_RANDOM_BYTES
SESSION_MINUTES=120
TRUST_PROXY=1
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_SERVER_SIDE_ONLY
SUPABASE_STORAGE_BUCKET=bitebrew-media
CRON_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
